# ---------------------------------------------------------------------------
# ForexMatch — example configuration.
# Copy to backend/.env and fill in. NEVER commit a real .env.
#
# NOTE ON AWS CREDENTIALS
# This project deliberately does NOT read AWS access keys from .env.
# Bedrock uses the standard AWS credential chain (env vars exported by your
# shell, ~/.aws/credentials, SSO, or an EC2/ECS/Lambda role). Configure it with
# `aws configure` or `aws sso login`. Only non-secret AWS settings live here.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://localhost:5432/forexmatch

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Amazon Bedrock (non-secret settings only) ------------------------------
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.3
# Set to "mock" to run the agent without Bedrock (deterministic offline model).
MODEL_PROVIDER=bedrock

# --- FX rates ---------------------------------------------------------------
# Supported: frankfurter (no key required), exchangerate_host, static
FX_PROVIDER=frankfurter
FX_API_KEY=
FX_CACHE_TTL_SECONDS=3600

# --- Web research -----------------------------------------------------------
# Supported: bedrock (Bedrock web search), none
RESEARCH_PROVIDER=bedrock
RESEARCH_MAX_RESULTS=5

# --- Admin ------------------------------------------------------------------
# Required to call /admin/* endpoints. Generate your own, e.g. `openssl rand -hex 32`.
ADMIN_SECRET=

# --- Analytics (optional; app works fine without) ---------------------------
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Error monitoring (optional) --------------------------------------------
SENTRY_DSN=
